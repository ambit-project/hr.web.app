# Lokalny stos (docker compose). Wartości deweloperskie — skopiuj do .env (start.sh robi to sam) i zmień,
# jeśli stos ma być dostępny poza tą maszyną. Nie commituj .env.
POSTGRES_PASSWORD=dev-postgres-password
HR_MIGRATOR_PASSWORD=dev-migrator-password
HR_API_PASSWORD=dev-api-password

# Porty na 127.0.0.1 (wspólny hr-local zajmuje 5432; aplikacja 6300-6301).
HR_DB_PORT=6332
HR_API_PORT=6300
HR_WEB_PORT=6301
